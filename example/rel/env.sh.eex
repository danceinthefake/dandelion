#!/bin/sh
# Clustering (Dandelion.Cluster, see lib/platform/application.ex): a node is <%= @release.name %>@<its private IP>
# and talks to the others on one port, 9100 (vm.args.eex).
case $RELEASE_COMMAND in
  start* | daemon* | remote | rpc)
    export RELEASE_DISTRIBUTION=name
    # NODE_IP: this machine's private IP. Set it on VMs, where `hostname -i`
    # can answer 127.0.1.1; in a container it's the container's IP.
    # NODE_HOST: a name that resolves to that IP, for a container on SEVERAL
    # networks, where `hostname -i` lists its addresses in no fixed order (and the
    # node could be named after the wrong one).
    if [ -z "${NODE_IP:-}" ] && [ -n "${NODE_HOST:-}" ]; then
      NODE_IP=$(getent hosts "$NODE_HOST" | cut -d' ' -f1)
    fi
    export RELEASE_NODE="<%= @release.name %>@${NODE_IP:-$(hostname -i | cut -d' ' -f1)}"

    # Tracing: every span says which node made it.
    export OTEL_RESOURCE_ATTRIBUTES="service.instance.id=${RELEASE_NODE}"

    # The cookie lets a node join — and run code on — every other node. It
    # comes from the environment (a secret store), the same on every node,
    # never from the image.
    if [ -z "${RELEASE_COOKIE:-}" ]; then
      echo "RELEASE_COOKIE is not set: generate one (mix phx.gen.secret 32) and give every node the same" >&2
      exit 1
    fi
    ;;
esac
