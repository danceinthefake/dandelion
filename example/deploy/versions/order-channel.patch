--- /dev/null
+++ b/example/priv/repo/migrations/20261011000001_add_order_channel.exs
@@ -0,0 +1,11 @@
+defmodule Platform.Database.Repo.Migrations.AddOrderChannel do
+  use Ecto.Migration
+
+  def change do
+    # Safe while the old code is still running: the column has a default, so an order made by
+    # code that doesn't know it gets "web", and code that doesn't know it never reads it.
+    alter table(:orders) do
+      add :channel, :text, null: false, default: "web"
+    end
+  end
+end
